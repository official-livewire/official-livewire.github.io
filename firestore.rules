rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'dlyons184@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isApproved() {
      return isAdmin() || (signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == false
        && request.resource.data.keys().hasOnly(['displayName','email','approved','createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.approved == false;
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','approvedAt'])
        && request.resource.data.approved is bool;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['text','uid','name','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow update, delete: if isAdmin();
    }
  }
}